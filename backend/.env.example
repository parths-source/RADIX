# Copy to backend/.env (git-ignored). Backend-only secrets: never expose to the browser.

# Supabase (service-role key bypasses RLS; keep it here only)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# LLM: Google Gemini. Extraction falls back to saved fixtures when unset or failing.
LLM_PROVIDER=google
LLM_MODEL=gemini-3.8-flash
LLM_FALLBACK_MODEL=gemini-3.5-flash
LLM_API_KEY=
ENABLE_LLM_MATCH=false

# CORS: the only origin allowed to call the API
FRONTEND_ORIGIN=http://localhost:5173

# Limits
MAX_UPLOAD_MB=5
LLM_MAX_INPUT_CHARS=20000
