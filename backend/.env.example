# Copy to backend/.env (git-ignored). Backend-only secrets: never expose to the browser.

# Supabase (service-role key bypasses RLS; keep it here only)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# LLM (provider not chosen yet; extraction falls back to fixtures when empty)
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
ENABLE_LLM_MATCH=false

# CORS: the only origin allowed to call the API
FRONTEND_ORIGIN=http://localhost:5173

# Limits
MAX_UPLOAD_MB=5
LLM_MAX_INPUT_CHARS=20000
